<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gourmet Moments – Chef Koltseg Nyilvantartas"
        Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="KoltsegGrid" Grid.Row="0" AutoGenerateColumns="True"
          IsReadOnly="True" AlternationCount="2"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Margin="10,10,0,0" HorizontalAlignment="Left" Width="294">
                <TextBlock Text="Sef neve: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="ChefNameBox" Margin="0,0,15,0"/>

                <TextBlock Text="Datum: " VerticalAlignment="Center" Margin="0,10,5,0"/>
                <DatePicker x:Name="DatumPicker" Margin="0,0,15,0"/>

                <TextBlock Text="Kategoria: " VerticalAlignment="Center" Margin="0,10,5,0"/>
                <ComboBox x:Name="KategoriaCombo" Margin="0,0,15,0">
                    <ComboBoxItem Content="Travel" IsSelected="True"/>
                    <ComboBoxItem Content="Ingredients"/>
                    <ComboBoxItem Content="Accommodation"/>
                    <ComboBoxItem Content="Equipment"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock Text="Osszeg (EUR): " VerticalAlignment="Center" Margin="0,10,5,0"/>
                <TextBox x:Name="OsszegBox" Margin="0,0,15,0"/>

                <TextBlock Text="Megjegyzes: " VerticalAlignment="Center" Margin="0,10,5,0"/>
                <TextBox x:Name="MegjegyzesBox" Margin="0,0,15,0"/>


            </StackPanel>
            <Button  Grid.Column="1" Content="Hozzaadas" Click="Hozzaadas_Click" Padding="10,3" Width="300" Height="100" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        </Grid>



    </Grid>
</Window>